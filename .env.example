# Copy to .env and fill in what the current phase needs. .env is never committed.
# Read only through src/meridian_dashboard_nyc/config.py.

# Phase 1: NYC and NYS Open Data without throttling
SOCRATA_APP_TOKEN=

# Phase 7: the app database (Postgres)
DATABASE_URL=

# Phase 8: the site-review agent
ANTHROPIC_API_KEY=

# Phase 9: sign-in (Auth.js) and map tiles on Cloudflare R2
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
TILES_BUCKET_KEY_ID=
TILES_BUCKET_SECRET=

# Phase 10, optional: census data
CENSUS_API_KEY=
